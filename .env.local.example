# Supabase Configuration
# Get these values from your Supabase project settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# For Vercel deployment, these variables should be set in your Vercel project settings
# They can use either VITE_ or NEXT_PUBLIC_ prefix
# Vercel automatically exposes NEXT_PUBLIC_* variables to the client
